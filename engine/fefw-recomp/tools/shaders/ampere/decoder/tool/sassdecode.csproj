<Project Sdk="Microsoft.NET.Sdk">

  <!-- sassdecode: decode Ampere code blocks; the verify mode compares with the nvdisasm oracle (work/shaders/oracle/SM86). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>sassdecode</AssemblyName>
    <RootNamespace>Nx.Shaders.Ampere.Tool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AmpereDecoder.csproj" />
  </ItemGroup>

</Project>
