# Build output
/target/
**/target/

# Derived from the user's own dump — never committed
/work/
/build/
*.bin
*.exe

# Python bridge environment
/.venv/

# Python bytecode from the release/validation tools
__pycache__/
*.pyc

# Local settings and generated scan reports
*.json
# The tested-build manifest is data the launcher ships, not a report.
!apps/emblemweave/data/dump_hashes.json
# Launcher translation catalogs are shipped data, not local reports.
!apps/emblemweave/assets/i18n/*.json
# The site reads these at runtime; they are release data, not local reports.
!docs/release.json
!docs/mirrors.json

# Launch videos made with /brag (they contain game footage: keep them local)
brag-output*/

# Local captures: they hold the desktop and game footage, so they stay on the machine. The scripts that take them
# (shots/*.ps1) are tracked, so the docs screenshots can be regenerated.
shots/*.png
shots/*.jpg
shots/**/*.png
shots/**/*.jpg
shots/*.b64

# Local diagnostics, captures and build scratch: none of this ships.
*.log
*.log.prev
/fefw_fatal.txt
/controls.ini
/shader_order.txt
/commit_message.txt
/shot_*.png
/build_test.cmd
/tt_test_out/
/.inspect/
/extract_exefs.py
/extract_romfs.py
/parse_nup.py
/engine/fefw-recomp/runtime/build_new/
/engine/fefw-recomp/runtime/test_dav1d/
/engine/fefw-recomp/runtime/src/nxrt_pch.h
/engine/fefw-recomp/runtime/src/gfx/nxrt_gfx_pch.h
